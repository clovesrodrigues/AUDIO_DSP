; Export table for OBS Studio 27.x module discovery on Windows.
; MinGW-w64 does not reliably turn OBS' visibility("default") macro into
; PE/COFF DLL exports, so keep the OBS entry points explicit here.
EXPORTS
    obs_module_load
    obs_module_set_pointer
    obs_module_ver
    obs_module_description
    obs_module_post_load
    obs_module_set_locale
    obs_module_free_locale
    obs_module_get_string
