[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run DSP Smoke Tests"

[[workflows.workflow]]
name = "Run DSP Smoke Tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash examples/run_new_dsp_smokes.sh"

[workflows.workflow.metadata]
outputType = "console"
